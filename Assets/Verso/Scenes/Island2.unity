  m_Script: {fileID: 11500000, guid: e28234ff3ae84c544a9fb19eb5509b39, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Verso.IslandManager
  crystalsRequired: 0
  introMessage: 
  introDuration: 4
  islandTitle: "Ilha 2 \xB7 Travessia"
  tipsPt:
  - "Aqui os degraus trocam de lado: um \xE9 dos Vivos, o pr\xF3ximo \xE9 do Al\xE9m."
  - "Pule primeiro e aperte F ainda no ar. Assim o pr\xF3ximo degrau aparece embaixo de voc\xEA!"
  - "No corredor, os espinhos s\xF3 existem no Al\xE9m. Atravesse nos Vivos."
  tipsEn:
  - 'Here the steps switch sides: one belongs to the Living, the next to the Beyond.'
  - Jump first, then press F while you're in the air. The next step will appear under you!
  - In the hallway, the spikes only exist in the Beyond. Cross it in the Living.
