    m_Alignment: 1
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1.15
  m_Text: "<size=96><b>VERSO</b></size>\n\n\n<color=#FFB347><b>Created, art and code by</b></color>\nLaryssa Aguiar Menjon\n\n<color=#FFB347><b>Music by</b></color>\nHAI Soundworks\nhaisoundworks.com\n\n<color=#FFB347><b>Sound effects (Pixabay)</b></color>\nJump \xB7 Aryan Raikundalia\nSoul \xB7 Universfield\nKey \xB7 Xmer\u2122\nLevel clear \xB7 CRYUG CEET\nGame over \xB7 Hanifi \u015Eahin\nClick \xB7 666HeroHero\nHover \xB7 u_uev3l0tolc\n\n<color=#FFB347><b>Sky</b></color>\nPSX Sky Sampler \xB7 Munchkin Gaming\n\n<color=#FFB347><b>Voices</b></color>\nElevenLabs\n\n<color=#FFB347><b>Fonts</b></color>\nLilita One and Fredoka\nSIL Open Font License\n\n\n<b>Thanks for playing!</b>"
